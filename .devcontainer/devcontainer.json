{
  "name": "3D Model Catalog",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "3D Model Catalog Web",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt && python seed_data.py",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "task.allowAutomaticTasks": "on"
      }
    }
  }
}
